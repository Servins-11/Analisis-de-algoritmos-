from typing import List
class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        posiciones = {}

        for i, num in enumerate(nums):
            faltante = target - num

            if faltante in posiciones:
                return [posiciones[faltante], i]

            posiciones[num] = i
        return []
